# ===== 필수: Gemini API =====
# Gemini_API_키_발급_안내.md 참고
GEMINI_API_KEY=

# ===== 로그인 (NextAuth) =====
# 아래 두 줄을 빈 값으로 두면 "데모 로그인"(이메일만 입력)이 자동으로 켜집니다.
# 실제 배포 전에는 반드시 채워서 진짜 Google 로그인으로 바꾸세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 아무 랜덤 문자열이나 넣으세요 (터미널에서: openssl rand -base64 32)
AUTH_SECRET=

# 학교 Google Workspace 도메인으로 로그인 제한 (선택, 예: myschool.hs.kr)
# 비워두면 아무 Google 계정이나 로그인 가능합니다.
ALLOWED_EMAIL_DOMAIN=

# ===== 데이터 저장 (Google Sheets) =====
# 아래 두 값이 없으면 자동으로 "데모 모드"로 동작합니다 (로컬 JSON 파일에 저장).
# 실제 운영하려면 INSTALL_GUIDE.md의 "구글 시트 구조" 단계를 따라 채우세요.
SPREADSHEET_ID=
# 서비스 계정 JSON 키 전체를 한 줄로(JSON 문자열 그대로 또는 base64로 인코딩해서) 넣습니다.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ===== 교사 대시보드 접근 제어 =====
# /teacher, /teacher/all, /teacher/live에 들어갈 수 있는 이메일. 콤마로 여러 개.
TEACHER_EMAILS=

# ===== 배포 주소 (채점 콜백 안정성에 중요) =====
# 배포 후 Vercel이 알려주는 정확한 프로덕션 주소를 넣으세요 (예: https://내프로젝트.vercel.app).
# 비워두면 Vercel의 배포별 임시 주소로 자동 대체되는데, 이 주소는 인증으로 막혀있어
# 채점 콜백이 오지 않는 문제가 생길 수 있습니다.
APP_URL=

# ===== (선택) QStash — 학생이 한꺼번에 몰릴 때 채점 큐 =====
# Gemini 무료 티어는 분당 15회 제한이 있습니다. 학급 인원이 그 이상 동시 제출하지
# 않는다면 비워둬도 됩니다(그 자리에서 바로 채점). https://console.upstash.com/ 의
# QStash 탭에서 발급받습니다.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
